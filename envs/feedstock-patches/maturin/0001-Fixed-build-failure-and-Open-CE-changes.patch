From: Archana-Shinde1 <archana.shinde1@ibm.com>
Date: Thu, 19 Mar 2026 13:12:57 +0000
Subject: [PATCH] Fixed build failure and Open-CE changes

---
 recipe/meta.yaml                         |  82 +++++++++++++++++++++++
 recipe/patches/fix-setuptools-rust.patch | Bin 0 -> 505 bytes
 recipe/patches/pyproject.patch           | Bin 0 -> 1146 bytes
 3 files changed, 82 insertions(+)
 create mode 100644 recipe/meta.yaml
 create mode 100644 recipe/patches/fix-setuptools-rust.patch
 create mode 100644 recipe/patches/pyproject.patch

diff --git a/recipe/meta.yaml b/recipe/meta.yaml
new file mode 100644
index 0000000..5eef8a1
--- /dev/null
+++ b/recipe/meta.yaml
@@ -0,0 +1,82 @@
+# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json
+
+{% set name = "maturin" %}
+{% set version = "1.9.4" %}
+
+package:
+  name: {{ name }}
+  version: {{ version }}
+
+source:
+  url: https://pypi.org/packages/source/m/maturin/maturin-{{ version }}.tar.gz
+  sha256: "235163a0c99bc6f380fb8786c04fd14dcf6cd622ff295ea3de525015e6ac40cf"
+  patches:
+    - patches/fix-setuptools-rust.patch
+    - patches/pyproject.patch
+
+build:
+  number: 2
+  # we only build 1 package for each target platform
+  # so only trigger the build on the lowest python version
+#  skip: "not match(python, python_min + '.*')"
+  # the `is_python_min` currently has a rendering bug, so do not use is_python_min
+  # until conda-smithy/issues/2320 is fixed
+  python:
+    version_independent: true
+
+  script_env:
+      MATURIN_SETUP_ARGS: "--no-default-features --features=full,native-tls,password-storage"
+      CARGO_NET_GIT_FETCH_WITH_CLI: "true"
+      OPENSSL_NO_VENDOR: "1"
+  script:
+    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml
+    - "{{ PYTHON }} -m pip install -v --use-pep517 --no-build-isolation ."
+requirements:
+  build:
+    - cargo-bundle-licenses
+    - {{ compiler('c') }}
+#    - "${{ stdlib('c') }}
+    - {{ compiler('rust') }}
+    - python    # [build_platform != target_platform]
+    - cross-python_${{ target_platform }}    # [build_platform != target_platform]
+  host:
+    - python
+    - pip
+    - setuptools
+    - setuptools-rust >=1.4.0
+    - wheel
+    - tomli >=1.1.0
+    - openssl   # [unix]
+    - pkg-config  # [unix]
+  run:
+    # do we really need python here?
+    - python
+    - tomli >=1.1.0
+
+  ignore_run_exports:
+    from_package:
+      # avoid run_requirements on cpython abi
+      - cross-python_${{ target_platform }}
+
+tests:
+  - imports:
+        - maturin
+  - script:
+      - maturin --help
+
+about:
+  homepage: https://github.com/PyO3/maturin
+  repository: https://github.com/PyO3/maturin
+  license: MIT
+  license_family: MIT
+  license_file:
+    - license-mit
+    - THIRDPARTY.yml
+  summary: >-
+    Build and publish crates with pyo3, rust-cpython and cffi bindings as well as rust binaries as python packages
+
+extra:
+  recipe-maintainers:
+    - messense
+    - apcamargo
+    - synapticarbors
